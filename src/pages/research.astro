---
import { leadershipClusters, odClusters } from "../data/researchPapers";

const allClusters = [...leadershipClusters, ...odClusters];

function getId(paper: any): string {
  const lastName = paper.author.split(',')[0].toLowerCase().replace(/[^a-z]/g, '');
  return `${lastName}_${paper.year}`;
}

const jaKeywords: Record<string, string> = {
  hamill_2013:         '身体的リーダー論',
  fisher_2015:         '身体的な実践',
  ladkin_2010:         '真正性と身体',
  ladkin_2008:         '美しくリードする',
  ladkin_2013:         '感じられる経験',
  karssiens_2014:      '身体知と余白',
  bathurst_2013:       'ジェスチャーの美',
  szelwach_2023:       '全人的な育成',
  rigg_2018:           '身体的省察',
  brendel_2016:        '身体とマインドフル',
  springborg_2010:     '感覚と芸術',
  bigo_2022:           'ヨガと学習',
  schuyler_2010:       '誠実性の訓練',
  hansen_2007:         '美的リーダー',
  ropo_2019:           '空間とリード',
  ropo_2013:           '場所と身体',
  ford_2017:           '物質的プレゼンス',
  raelin_2005:         '集合的リーダー',
  raelin_2016:         '実践としてのリーダー',
  lord_2011:           '象徴・接続・身体知',
  harquail_2010:       '身体化した組織認識',
  styhre_2004:         '組織の再身体化',
  wright_2019:         '身体的ルーティン',
  lockwoodharris_2023: '組織的身体操作',
  kupers_2011:         '現象学と組織',
  edmondson_1999:      '心理的安全性',
  heaphy_2008:         '身体と社会的交流',
  gordon_2020:         '生理的同期',
  reinero_2021:        '脳間同期',
  bushe_2009:          'ODの対話的転換',
  kenward_2018:        'OD身体実践',
  hanold_2017:         '対話的真正性',
  haines_2019:         'トラウマと癒し',
  scharmer_2009:       'U理論',
  creary_2022:         '過労と回復',
  porges_2022:         'ポリヴェーガル理論',
  kirrane_2025:        '神経系とリーダー',
  crossan_1999:        '組織学習の枠組み',
  nonaka_1998:         '「場」の概念',
  tsoukas_2003:        '暗黙知への問い',
  wenger_1998:         '実践コミュニティ',
};

const clusterColorMap: Record<string, string> = {
  core:       '#9e4630',
  somatic:    '#8a7060',
  aesthetics: '#b06878',
  leaderful:  '#5a7870',
  theory:     '#607890',
  team:       '#507878',
  somaticOD:  '#9a7848',
  neuro:      '#807060',
  learning:   '#708060',
};

const nodes = allClusters.flatMap(cluster =>
  cluster.papers.map((paper: any) => ({
    id:           getId(paper),
    authorShort:  paper.author.split(',')[0],
    author:       paper.author,
    year:         paper.year,
    title:        paper.title,
    journal:      paper.journal,
    abstract:     paper.abstract,
    practice:     paper.intervention?.practice ?? '',
    study:        paper.intervention?.study ?? '',
    cluster:      cluster.key,
    clusterLabel: cluster.label,
    citations:    paper.citations ?? null,
    isBook:       paper.isBook ?? false,
    color:        clusterColorMap[cluster.key] ?? '#888',
    iconPath:     cluster.iconPath,
    keyword:      jaKeywords[getId(paper)] ?? '',
  }))
);

// Within-cluster: all-to-all
const edges: any[] = [];
allClusters.forEach(cluster => {
  const papers = nodes.filter(n => n.cluster === cluster.key);
  for (let i = 0; i < papers.length; i++) {
    for (let j = i + 1; j < papers.length; j++) {
      edges.push({ source: papers[i].id, target: papers[j].id, edgeType: 'cluster', theme: cluster.key });
    }
  }
});

// Thematic cross-cluster edges
const thematic = [
  { source: 'edmondson_1999', target: 'porges_2022',   theme: '場の安全' },
  { source: 'edmondson_1999', target: 'kirrane_2025',  theme: '場の安全' },
  { source: 'porges_2022',    target: 'kirrane_2025',  theme: '場の安全' },
  { source: 'porges_2022',    target: 'kenward_2018',  theme: '場の安全' },
  { source: 'edmondson_1999', target: 'kenward_2018',  theme: '場の安全' },
  { source: 'ladkin_2010',    target: 'hanold_2017',   theme: '真正性' },
  { source: 'ladkin_2010',    target: 'schuyler_2010', theme: '真正性' },
  { source: 'hanold_2017',    target: 'schuyler_2010', theme: '真正性' },
  { source: 'porges_2022',    target: 'heaphy_2008',   theme: '神経・生理' },
  { source: 'porges_2022',    target: 'gordon_2020',   theme: '神経・生理' },
  { source: 'kirrane_2025',   target: 'heaphy_2008',   theme: '神経・生理' },
  { source: 'heaphy_2008',    target: 'gordon_2020',   theme: '神経・生理' },
  { source: 'gordon_2020',    target: 'reinero_2021',  theme: '神経・生理' },
  { source: 'scharmer_2009',  target: 'haines_2019',   theme: '変革・変容' },
  { source: 'scharmer_2009',  target: 'bushe_2009',    theme: '変革・変容' },
  { source: 'haines_2019',    target: 'bushe_2009',    theme: '変革・変容' },
  { source: 'creary_2022',    target: 'scharmer_2009', theme: '変革・変容' },
  { source: 'hansen_2007',    target: 'springborg_2010', theme: '美学・感覚' },
  { source: 'ladkin_2008',    target: 'hansen_2007',   theme: '美学・感覚' },
  { source: 'bathurst_2013',  target: 'springborg_2010', theme: '美学・感覚' },
  { source: 'ladkin_2013',    target: 'springborg_2010', theme: '美学・感覚' },
  { source: 'tsoukas_2003',   target: 'nonaka_1998',   theme: '暗黙知・身体知' },
  { source: 'tsoukas_2003',   target: 'wenger_1998',   theme: '暗黙知・身体知' },
  { source: 'nonaka_1998',    target: 'wenger_1998',   theme: '暗黙知・身体知' },
  { source: 'styhre_2004',    target: 'wright_2019',   theme: '暗黙知・身体知' },
  { source: 'styhre_2004',    target: 'kupers_2011',   theme: '暗黙知・身体知' },
  { source: 'wright_2019',    target: 'tsoukas_2003',  theme: '暗黙知・身体知' },
  { source: 'raelin_2005',    target: 'gordon_2020',   theme: '集合的実践' },
  { source: 'raelin_2016',    target: 'bushe_2009',    theme: '集合的実践' },
  { source: 'raelin_2005',    target: 'bushe_2009',    theme: '集合的実践' },
  { source: 'raelin_2016',    target: 'reinero_2021',  theme: '集合的実践' },
  { source: 'ropo_2019',      target: 'nonaka_1998',   theme: '空間・物質性' },
  { source: 'ropo_2013',      target: 'ford_2017',     theme: '空間・物質性' },
  { source: 'ford_2017',      target: 'ropo_2019',     theme: '空間・物質性' },
  { source: 'rigg_2018',      target: 'crossan_1999',  theme: '身体学習' },
  { source: 'brendel_2016',   target: 'crossan_1999',  theme: '身体学習' },
  { source: 'bigo_2022',      target: 'wenger_1998',   theme: '身体学習' },
  { source: 'kenward_2018',   target: 'haines_2019',   theme: 'OD実践' },
  { source: 'kenward_2018',   target: 'bushe_2009',    theme: 'OD実践' },
  { source: 'hanold_2017',    target: 'haines_2019',   theme: 'OD実践' },
];
thematic.forEach(e => edges.push({ ...e, edgeType: 'thematic' }));

const contexts = [
  { key: '場の安全',    color: '#06B6D4' },
  { key: '真正性',      color: '#EC4899' },
  { key: '神経・生理',  color: '#EF4444' },
  { key: '変革・変容',  color: '#F97316' },
  { key: '美学・感覚',  color: '#8B5CF6' },
  { key: '暗黙知・身体知', color: '#3B82F6' },
  { key: '集合的実践',  color: '#10B981' },
  { key: '空間・物質性', color: '#84CC16' },
  { key: '身体学習',    color: '#F59E0B' },
  { key: 'OD実践',     color: '#A855F7' },
];

const clusterList = allClusters.map(c => ({
  key: c.key, label: c.label,
  color: clusterColorMap[c.key] ?? '#888',
  iconPath: c.iconPath,
}));

const graphJSON      = JSON.stringify({ nodes, edges });
const contextsJSON   = JSON.stringify(contexts);
const clustersJSON   = JSON.stringify(clusterList);
