  </div>
</div>
<div id="popup-overlay" class="hidden"></div>

<!-- Data elements -->
<script type="application/json" id="gd" set:html={graphJSON}></script>
<script type="application/json" id="cd" set:html={contextsJSON}></script>
<script type="application/json" id="kd" set:html={clustersJSON}></script>

