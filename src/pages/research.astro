<script>
  import * as d3 from 'd3';
  const { nodes, edges } = JSON.parse(document.getElementById('gd').textContent);
  const contexts  = JSON.parse(document.getElementById('cd').textContent);
  const clusters  = JSON.parse(document.getElementById('kd').textContent);

  // State
  let activeCluster = null;
  let activeContext = null;
  let searchQuery   = '';

  // Helpers
  function getRadius(citations) {
    if (!citations) return 7;
    if (citations >= 10000) return 20;
    if (citations >= 2000)  return 16;
    if (citations >= 500)   return 13;
    if (citations >= 100)   return 10;
    return 7;
  }

  // Build connected-node lookup
  function buildAdjacency(links) {
    const adj = new Map();
    links.forEach(l => {
      const s = l.source.id ?? l.source;
      const t = l.target.id ?? l.target;
      if (!adj.has(s)) adj.set(s, new Set());
      if (!adj.has(t)) adj.set(t, new Set());
      adj.get(s).add(t);
      adj.get(t).add(s);
    });
    return adj;
  }

  // D3 setup
  const container = document.getElementById('graph-wrap');
  const svgEl     = document.getElementById('svg');
  let W = container.clientWidth;
  let H = container.clientHeight;

  const svg = d3.select('#svg');

  // Zoom
  const zoomG = svg.append('g').attr('class', 'zoom-root');
  const zoom = d3.zoom()
    .scaleExtent([0.3, 4])
    .on('zoom', e => zoomG.attr('transform', e.transform));
  svg.call(zoom);

  // Glow filter
  const defs = svg.append('defs');
  const filter = defs.append('filter').attr('id', 'glow').attr('x', '-50%').attr('y', '-50%').attr('width', '200%').attr('height', '200%');
  filter.append('feGaussianBlur').attr('stdDeviation', '3').attr('result', 'blur');
  const merge = filter.append('feMerge');
  merge.append('feMergeNode').attr('in', 'blur');
  merge.append('feMergeNode').attr('in', 'SourceGraphic');

  // Link group
  const linkG = zoomG.append('g').attr('class', 'links');
  // Node group
  const nodeG = zoomG.append('g').attr('class', 'nodes');

  // Simulation
  const simulation = d3.forceSimulation(nodes)
    .force('link', d3.forceLink(edges).id(d => d.id).distance(d => d.edgeType === 'cluster' ? 120 : 260).strength(d => d.edgeType === 'cluster' ? 0.2 : 0.08))
    .force('charge', d3.forceManyBody().strength(-500))
    .force('center', d3.forceCenter(W / 2, H / 2))
    .force('x', d3.forceX(W / 2).strength(0.04))
    .force('y', d3.forceY(H / 2).strength(0.04))
    .force('collision', d3.forceCollide().radius(d => getRadius(d.citations) + 48));

  // Draw links (curved paths)
  const link = linkG.selectAll('path')
    .data(edges)
    .join('path')
    .attr('class', 'link')
    .attr('fill', 'none')
    .attr('stroke', d => d.edgeType === 'thematic'
      ? (contexts.find(c => c.key === d.theme)?.color ?? '#1a1a18')
      : '#1a1a18')
    .attr('stroke-opacity', d => d.edgeType === 'thematic' ? 0.18 : 0.08)
    .attr('stroke-width', d => d.edgeType === 'thematic' ? 1.2 : 0.6);

  // Draw nodes
  const nodeGroup = nodeG.selectAll('g')
    .data(nodes)
    .join('g')
    .attr('class', 'node-group')
    .style('cursor', 'pointer')
    .call(d3.drag()
      .on('start', (event, d) => {
        if (!event.active) simulation.alphaTarget(0.3).restart();
        d.fx = d.x; d.fy = d.y;
      })
      .on('drag', (event, d) => { d.fx = event.x; d.fy = event.y; })
      .on('end', (event, d) => {
        if (!event.active) simulation.alphaTarget(0);
        d.fx = null; d.fy = null;
      })
    );

  // Soft halo (behind)
  nodeGroup.append('circle')
    .attr('r', d => getRadius(d.citations) + 6)
    .attr('fill', d => d.color)
    .attr('opacity', 0.08);

  // Main circle
  nodeGroup.append('circle')
    .attr('class', 'node-circle')
    .attr('r', d => getRadius(d.citations))
    .attr('fill', d => d.color)
    .attr('fill-opacity', 0.7)
    .attr('stroke', d => d.color)
    .attr('stroke-width', 1)
    .attr('stroke-opacity', 0.4);

  // Icon (SVG path scaled inside circle)
  nodeGroup.append('g')
    .attr('class', 'node-icon')
    .each(function(d) {
      const r = getRadius(d.citations);
      const scale = (r * 1.1) / 12;
      d3.select(this)
        .append('path')
        .attr('d', d.iconPath)
        .attr('transform', `translate(${-12 * scale}, ${-12 * scale}) scale(${scale})`)
        .attr('fill', 'none')
        .attr('stroke', 'rgba(247,245,240,0.85)')
        .attr('stroke-width', 1.5 / scale)
        .attr('stroke-linecap', 'round')
        .attr('stroke-linejoin', 'round');
    });

  // Keyword label (title before colon, max 4 words)
  nodeGroup.append('text')
    .attr('dy', d => getRadius(d.citations) + 14)
    .attr('text-anchor', 'middle')
    .style('font-family', "'Noto Sans JP', sans-serif")
    .style('font-size', '10px')
    .style('font-weight', '300')
    .style('fill', d => d.color)
    .style('letter-spacing', '0.04em')
    .style('pointer-events', 'none')
    .style('user-select', 'none')
    .text(d => d.keyword || d.title.split(':')[0].split(/\s+/).slice(0, 3).join(' '));

  // Author + year (smaller, below keyword)
  nodeGroup.append('text')
    .attr('class', 'node-label')
    .attr('dy', d => getRadius(d.citations) + 26)
    .attr('text-anchor', 'middle')
    .style('font-family', "'Noto Sans JP', sans-serif")
    .style('font-size', '9px')
    .style('font-weight', '300')
    .style('fill', 'rgba(26,26,24,0.38)')
    .style('letter-spacing', '0.04em')
    .style('pointer-events', 'none')
    .style('user-select', 'none')
    .text(d => `${d.authorShort} ${d.year}`);

  // Simulation tick — curved paths
  simulation.on('tick', () => {
    link.attr('d', d => {
      const sx = d.source.x, sy = d.source.y;
      const tx = d.target.x, ty = d.target.y;
      const mx = (sx + tx) / 2, my = (sy + ty) / 2;
      const dx = tx - sx, dy = ty - sy;
      const len = Math.sqrt(dx * dx + dy * dy) || 1;
      const curve = Math.min(len * 0.14, 36);
      const cx = mx + (-dy / len) * curve;
      const cy = my + (dx / len) * curve;
      return `M${sx},${sy} Q${cx},${cy} ${tx},${ty}`;
    });
    nodeGroup.attr('transform', d => `translate(${d.x},${d.y})`);
  });

  // After layout settles, switch to gentle float mode
  simulation.on('end', () => {
    let t = 0;
    simulation.force('drift', function() {
      t += 0.5;
      nodes.forEach((d, i) => {
        d.vx += Math.sin(t * 0.007 + i * 2.3) * 0.22;
        d.vy += Math.cos(t * 0.009 + i * 1.7) * 0.22;
      });
    });
    simulation
      .velocityDecay(0.68)
      .alphaDecay(0)
      .alpha(0.06)
      .restart();
  });

  // Hover + click interactions
  const adj = buildAdjacency(edges);
  let lockedId = null;
  const lockHint = document.getElementById('lock-hint');

  function applyNodeHighlight(d) {
    const connected = adj.get(d.id) ?? new Set();
    nodeGroup.select('circle.node-circle')
      .attr('fill-opacity', n => n.id === d.id ? 1 : connected.has(n.id) ? 0.85 : 0.15)
      .attr('stroke-opacity', n => n.id === d.id ? 1 : connected.has(n.id) ? 0.6 : 0.1);
    nodeGroup.select('.node-icon path')
      .attr('stroke', n => n.id === d.id || connected.has(n.id) ? 'rgba(247,245,240,0.9)' : 'rgba(247,245,240,0.3)');
    nodeGroup.selectAll('text')
      .attr('opacity', n => n.id === d.id ? 1 : connected.has(n.id) ? 0.8 : 0.1);
    link
      .attr('stroke-opacity', l => {
        const s = l.source.id, t = l.target.id;
        return (s === d.id || t === d.id) ? (l.edgeType === 'thematic' ? 0.85 : 0.5) : 0.02;
      })
      .attr('stroke-width', l => {
        const s = l.source.id, t = l.target.id;
        return (s === d.id || t === d.id) ? (l.edgeType === 'thematic' ? 1.5 : 0.8) : 0.5;
      });
  }

  nodeGroup
    .on('mouseover', function(event, d) {
      if (lockedId) return; // don't override locked highlight
      applyNodeHighlight(d);
    })
    .on('mouseout', function() {
      if (lockedId) return; // keep locked highlight
      applyFilter();
    })
    .on('click', function(event, d) {
      event.stopPropagation();
      if (lockedId === d.id) {
        // second click on same node → open popup
        openPopup(d);
      } else {
        // first click → lock highlight, allow tracing connections
        lockedId = d.id;
        applyNodeHighlight(d);
        lockHint.classList.add('visible');
      }
    });

  // Click on background → unlock
  svg.on('click', function() {
    if (lockedId) {
      lockedId = null;
      applyFilter();
      lockHint.classList.remove('visible');
    }
  });

  // Popup
  const popup        = document.getElementById('popup');
  const overlay      = document.getElementById('popup-overlay');
  const popupClose   = document.getElementById('popup-close');
  const popupCluster = document.getElementById('popup-cluster');
  const popupTitle   = document.getElementById('popup-title');
  const popupMeta    = document.getElementById('popup-meta');
  const popupAbstract = document.getElementById('popup-abstract');
  const popupScholar  = document.getElementById('popup-scholar');
  const popupPractice = document.getElementById('popup-practice');

  function openPopup(d) {
    popupCluster.textContent  = d.clusterLabel;
    popupCluster.style.color  = d.color;
    popupTitle.textContent    = d.title;
    popupMeta.textContent     = `${d.author}  /  ${d.year}  /  ${d.journal}${d.citations ? '  /  ' + d.citations.toLocaleString() + ' 引用' : ''}`;
    popupAbstract.textContent = d.abstract;
    popupScholar.href         = `https://scholar.google.com/scholar?q=${encodeURIComponent(d.title + ' ' + d.author.split(',')[0])}`;
    popupPractice.textContent = d.practice || '—';
    popup.classList.remove('hidden');
    overlay.classList.remove('hidden');
  }

  function closePopup() {
    popup.classList.add('hidden');
    overlay.classList.add('hidden');
  }

  popupClose.addEventListener('click', closePopup);
  overlay.addEventListener('click', closePopup);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePopup(); });

  // Count display
  document.getElementById('topbar-count').textContent = `${nodes.length} 論文`;

  // Filter logic
  function applyFilter() {
    const query = searchQuery.toLowerCase();

    const visibleIds = new Set(
      nodes.filter(n => {
        const matchCluster  = !activeCluster || n.cluster === activeCluster;
        const contextNodes  = activeContext
          ? edges.filter(e => e.theme === activeContext)
              .flatMap(e => [e.source.id ?? e.source, e.target.id ?? e.target])
          : null;
        const matchContext  = !activeContext || (contextNodes && contextNodes.includes(n.id));
        const matchSearch   = !query
          || n.authorShort.toLowerCase().includes(query)
          || n.author.toLowerCase().includes(query)
          || n.title.toLowerCase().includes(query)
          || n.clusterLabel.toLowerCase().includes(query);
        return matchCluster && matchContext && matchSearch;
      }).map(n => n.id)
    );

    nodeGroup.select('circle.node-circle')
      .attr('fill-opacity', n => visibleIds.has(n.id) ? 0.85 : 0.1)
      .attr('stroke-opacity', n => visibleIds.has(n.id) ? 0.6 : 0.05);
    nodeGroup.select('.node-icon path')
      .attr('stroke', n => visibleIds.has(n.id) ? 'rgba(6,8,15,0.8)' : 'rgba(6,8,15,0.2)');
    nodeGroup.select('text')
      .attr('opacity', n => visibleIds.has(n.id) ? 0.7 : 0.08);
    link.attr('stroke-opacity', l => {
      const s = l.source.id ?? l.source, t = l.target.id ?? l.target;
      return visibleIds.has(s) && visibleIds.has(t)
        ? (l.edgeType === 'thematic' ? 0.35 : 0.12)
        : 0.02;
    });
  }

  // Build cluster chips
  const clusterWrap = document.getElementById('cluster-filters');
  clusters.forEach(c => {
    const chip = document.createElement('button');
    chip.className = 'chip';
    chip.dataset.key = c.key;
    chip.innerHTML = `<span class="chip-dot" style="background:${c.color}"></span>${c.label}`;
    chip.addEventListener('click', () => {
      if (activeCluster === c.key) {
        activeCluster = null;
        chip.classList.remove('active');
        chip.style.background = '';
        chip.style.borderColor = '';
      } else {
        activeCluster = c.key;
        activeContext = null;
        document.querySelectorAll('#cluster-filters .chip').forEach(el => {
          el.classList.remove('active');
          el.style.background = '';
          el.style.borderColor = '';
        });
        document.querySelectorAll('#context-filters .chip').forEach(el => {
          el.classList.remove('active');
          el.style.background = '';
          el.style.borderColor = '';
        });
        chip.classList.add('active');
        chip.style.background = c.color;
        chip.style.borderColor = c.color;
      }
      applyFilter();
    });
    clusterWrap.appendChild(chip);
  });

  // Build context chips
  const contextWrap = document.getElementById('context-filters');
  contexts.forEach(ctx => {
    const chip = document.createElement('button');
    chip.className = 'chip';
    chip.dataset.key = ctx.key;
    chip.innerHTML = `<span class="chip-dot" style="background:${ctx.color}"></span>${ctx.key}`;
    chip.addEventListener('click', () => {
      if (activeContext === ctx.key) {
        activeContext = null;
        chip.classList.remove('active');
        chip.style.background = '';
        chip.style.borderColor = '';
      } else {
        activeContext = ctx.key;
        activeCluster = null;
        document.querySelectorAll('#context-filters .chip').forEach(el => {
          el.classList.remove('active');
          el.style.background = '';
          el.style.borderColor = '';
        });
        document.querySelectorAll('#cluster-filters .chip').forEach(el => {
          el.classList.remove('active');
          el.style.background = '';
          el.style.borderColor = '';
        });
        chip.classList.add('active');
        chip.style.background = ctx.color;
        chip.style.borderColor = ctx.color;
      }
      applyFilter();
    });
    contextWrap.appendChild(chip);
  });

  // Search
  document.getElementById('search').addEventListener('input', function() {
    searchQuery = this.value;
    applyFilter();
  });

  // Reset
  document.getElementById('reset-btn').addEventListener('click', () => {
    activeCluster = null;
    activeContext = null;
    searchQuery   = '';
    document.getElementById('search').value = '';
    document.querySelectorAll('.chip').forEach(el => {
      el.classList.remove('active');
      el.style.background = '';
      el.style.borderColor = '';
    });
    applyFilter();
  });

  // Resize
  new ResizeObserver(() => {
    W = container.clientWidth;
    H = container.clientHeight;
    simulation.force('center', d3.forceCenter(W / 2, H / 2)).alpha(0.3).restart();
  }).observe(container);

  // Mobile sidebar toggle
  const sidebarToggle  = document.getElementById('sidebar-toggle');
  const sidebarEl      = document.getElementById('sidebar');
  const sidebarOverlay = document.getElementById('sidebar-overlay');

  function openSidebar()  { sidebarEl.classList.add('open');    sidebarOverlay.classList.add('active'); }
  function closeSidebar() { sidebarEl.classList.remove('open'); sidebarOverlay.classList.remove('active'); }

  sidebarToggle?.addEventListener('click', () => {
    sidebarEl.classList.contains('open') ? closeSidebar() : openSidebar();
  });
  sidebarOverlay?.addEventListener('click', closeSidebar);

</script>

</body>
</html>
