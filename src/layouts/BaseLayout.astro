---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Human Body Project — 身体の解像度を上げる' } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Human Body Project</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header style="background:var(--color-surface);border-bottom:1px solid var(--color-border);position:sticky;top:0;z-index:50;">
      <div style="max-width:1100px;margin:0 auto;padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:56px;">
        <a href="/" style="font-weight:700;font-size:1rem;color:var(--color-text);text-decoration:none;display:flex;align-items:center;gap:0.5rem;">
          <span style="color:var(--color-accent);">●</span> Human Body Project
        </a>
        <nav style="display:flex;gap:1.5rem;font-size:0.875rem;">
          <a href="/" style="color:var(--color-text-muted);text-decoration:none;" onmouseover="this.style.color='var(--color-text)'" onmouseout="this.style.color='var(--color-text-muted)'">ホーム</a>
          <a href="/search" style="color:var(--color-text-muted);text-decoration:none;" onmouseover="this.style.color='var(--color-text)'" onmouseout="this.style.color='var(--color-text-muted)'">検索</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer style="border-top:1px solid var(--color-border);margin-top:4rem;padding:2rem 1.5rem;text-align:center;color:var(--color-text-muted);font-size:0.8rem;">
      Human Body Project — L1〜L10で身体を読む
    </footer>
  </body>
</html>
