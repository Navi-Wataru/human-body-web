---
import "../styles/od.css";

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Body OD — 身体を入口にした場と空気の探究",
  description = "認知の前にある身体の状態。身体性を土台にした、場と空気の探究。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://od.navigatejpn.com/od" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://od.navigatejpn.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://od.navigatejpn.com/og-image.png" />

    <link rel="icon" href="/favicon-kankaku.png" type="image/png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#f6f3ec" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Body OD" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@300;400;500&display=swap"
    />

    <slot name="head" />
  </head>

  <body>
    <nav>
      <div class="brand">
        <b>Body OD</b>
        身体を入口にした 場と空気の探究
      </div>
      <div class="links">
        <a href="https://bmr.navigatejpn.com" target="_blank" rel="noopener noreferrer">Body-Mind Reading®</a>
        <a href="/research">文献マップ</a>
        <a href="/profile.pdf" target="_blank" rel="noopener noreferrer">Profile</a>
      </div>
    </nav>

    <slot />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
