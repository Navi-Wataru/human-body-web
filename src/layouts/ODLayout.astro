---
import "../styles/od.css";

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Body-Mind Reading® — 身体を入口にした、しっくり感の探究",
  description = "組織開発とエグゼクティブコーチングに身体性のレイヤーを。認知アプローチの限界の先へ、Body-Mind Reading®で身体の言葉を読む。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://od.navigatejpn.com/od" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://od.navigatejpn.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://od.navigatejpn.com/og-image.png" />

    <link rel="icon" href="/favicon-kankaku.png" type="image/png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#f6f3ec" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Body OD" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant:wght@400;500&family=Fraunces:wght@400;500&family=Shippori+Mincho:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@300;400;500&display=swap"
    />

    <slot name="head" />
  </head>

  <body>

    <nav>
      <a href="/od" class="od-logo" aria-label="Body-Mind Reading®">
        <svg class="od-mark" viewBox="22 22 76 76" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
          <path d="M63.1 79.2L64.3 78.2L65.5 77.2L66.6 76.1L67.6 74.9L68.6 73.7L69.5 72.5L70.4 71.2L71.2 69.8L71.9 68.5L72.5 67.0L73.1 65.6L73.6 64.0L73.9 62.5L74.2 60.9L74.3 59.3L74.3 57.6L74.2 56.0L74.0 54.4L73.6 52.8L73.0 51.3L72.4 49.8L71.6 48.3L70.7 47.0L69.6 45.7L68.5 44.5L67.3 43.4L66.0 42.4L64.7 41.6L63.3 40.8L61.9 40.1L60.4 39.5L58.9 39.0L57.4 38.6L55.9 38.2L54.4 38.0L52.9 37.8L51.3 37.7L49.8 37.6L48.2 37.7L46.6 37.8L45.1 38.0L43.5 38.4L42.0 38.8L40.5 39.4L39.0 40.0L37.6 40.8L36.2 41.7L34.9 42.7L33.7 43.8L32.6 45.0L31.6 46.3L30.8 47.7L30.0 49.2L29.4 50.7L28.9 52.3L28.6 53.8L28.3 55.4L28.2 57.0L28.2 58.6L28.3 60.2L28.5 61.8L28.8 63.3L29.1 64.8L29.6 66.3L30.1 67.8L30.7 69.2L31.3 70.6L32.1 72.0L32.9 73.3L33.8 74.6L34.7 75.8L35.8 77.0L36.9 78.2L38.1 79.2L39.4 80.2L40.8 81.1L42.2 81.8L43.7 82.5L45.3 83.0L46.9 83.3L48.5 83.6L50.2 83.7L51.8 83.6L53.4 83.4L55.0 83.1L56.6 82.6"/>
          <path d="M56.5 40.0L55.2 41.0L54.0 42.1L52.8 43.2L51.8 44.5L50.9 45.8L50.1 47.2L49.4 48.6L48.7 50.0L48.2 51.5L47.7 53.0L47.4 54.5L47.1 56.0L46.8 57.5L46.7 59.1L46.6 60.6L46.6 62.2L46.7 63.8L46.9 65.3L47.2 66.9L47.6 68.4L48.1 69.9L48.7 71.4L49.5 72.9L50.3 74.3L51.3 75.6L52.4 76.8L53.6 78.0L54.8 79.0L56.2 79.9L57.6 80.7L59.1 81.4L60.7 81.9L62.2 82.3L63.8 82.6L65.4 82.7L67.0 82.8L68.6 82.7L70.2 82.6L71.7 82.3L73.3 82.0L74.8 81.6L76.2 81.1L77.7 80.5L79.1 79.9L80.5 79.2L81.8 78.4L83.1 77.6L84.4 76.7L85.6 75.6L86.8 74.5L87.8 73.4L88.8 72.1L89.8 70.8L90.6 69.3L91.2 67.9L91.8 66.3L92.2 64.7L92.5 63.1L92.6 61.5L92.6 59.8L92.5 58.2L92.2 56.6L91.8 55.0L91.3 53.5L90.6 52.0L89.9 50.6L89.1 49.2L88.2 47.9L87.2 46.7L86.1 45.5L85.1 44.4L83.9 43.4L82.7 42.4L81.5 41.5L80.2 40.6L78.8 39.8L77.5 39.1L76.0 38.5L74.6 37.9L73.0 37.4L71.5 37.1L69.9 36.8L68.3 36.7L66.6 36.7L65.0 36.8L63.4 37.0"/>
          <circle cx="60" cy="60" r="1.9" fill="currentColor" stroke="none"/>
        </svg>
        <div class="od-wm">
          <span class="od-name">Body-Mind Reading®</span>
          <span class="od-tag">身体を入口にした、しっくり感の探究</span>
        </div>
      </a>
      <div class="links">
        <a href="/research">文献マップ</a>
        <a href="#about">Profile</a>
      </div>
    </nav>

    <slot />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
