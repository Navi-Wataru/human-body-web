---
import "../styles/od.css";

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Body OD — 身体を入口にした組織開発の探究",
  description = "組織開発とエグゼクティブコーチングに身体性のレイヤーを。認知アプローチの限界の先へ、Body-Mind Reading®で身体の言葉を読む。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://od.navigatejpn.com/od" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://od.navigatejpn.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://od.navigatejpn.com/og-image.png" />

    <link rel="icon" href="/favicon-kankaku.png" type="image/png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#f6f3ec" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Body OD" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant:wght@400;500&family=Fraunces:wght@400;500&family=Shippori+Mincho:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@300;400;500&display=swap"
    />

    <slot name="head" />
  </head>

  <body>

    <nav>
      <a href="/od" class="od-logo" aria-label="Body OD">
        <svg class="od-mark" viewBox="0 0 100 48" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 24.0L8 24.6L10 25.4L12 26.4L14 27.6L16 28.8L18 30.0L20 31.1L22 32.1L24 32.9L26 33.4L28 33.6L30 33.4L32 32.9L34 32.1L36 30.9L38 29.4L40 27.6L42 25.7L44 23.6L46 21.5L48 19.4L50 17.4L52 15.5L54 13.9L56 12.6L58 11.6L60 11.0L62 10.8L64 10.9L66 11.4L68 12.2L70 13.3L72 14.6L74 16.0L76 17.5L78 19.0L80 20.4L82 21.7L84 22.8L86 23.6L88 24.2L90 24.4L92 24.4L94 24.0"/>
          <path d="M6 24.0L8 23.4L10 22.6L12 21.6L14 20.4L16 19.2L18 18.0L20 16.9L22 15.9L24 15.1L26 14.6L28 14.4L30 14.6L32 15.1L34 15.9L36 17.1L38 18.6L40 20.4L42 22.3L44 24.4L46 26.5L48 28.6L50 30.6L52 32.5L54 34.1L56 35.4L58 36.4L60 37.0L62 37.2L64 37.1L66 36.6L68 35.8L70 34.7L72 33.4L74 32.0L76 30.5L78 29.0L80 27.6L82 26.3L84 25.2L86 24.4L88 23.8L90 23.6L92 23.6L94 24.0"/>
        </svg>
        <div class="od-wm">
          <span class="od-name">Body OD</span>
          <span class="od-tag">身体を入口にした組織開発の探究</span>
        </div>
      </a>
      <div class="links">
        <a href="https://bmr.navigatejpn.com" target="_blank" rel="noopener noreferrer">Body-Mind Reading®</a>
        <a href="/research">文献マップ</a>
        <a href="#about">Profile</a>
      </div>
    </nav>

    <slot />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
