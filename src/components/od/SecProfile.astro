<section class="mx-auto max-w-measure px-gutter py-section">
  <hr class="border-0 border-t border-line mb-14" />

  <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="font-latin text-[11px] tracking-[0.18em] uppercase text-ink-muted mb-3">Profile</p>
      <h2 class="font-serif text-[28px] font-normal text-ink leading-snug">
        早田 航について
      </h2>
      <p class="mt-4 font-sans text-small font-light leading-[1.9] text-ink-soft max-w-[420px]">
        経歴・資格・できることをまとめたプロフィール資料です。
      </p>
    </div>

    <a
      href="/profile.pdf"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-3 border border-ink px-6 py-3 font-sans text-small font-light text-ink no-underline hover:bg-ink hover:text-canvas transition-colors whitespace-nowrap"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="7 10 12 15 17 10"/>
        <line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      プロフィールを見る
    </a>
  </div>
</section>
