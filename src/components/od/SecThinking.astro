---
---
<section class="wrap" style="--rhythm: 0.86">
  <div class="spacer-l"></div>
  <div class="section-label reveal">考え方</div>

  <div class="mark reveal" aria-hidden="true">
    <svg width="124" height="34" viewBox="0 0 124 34" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round">
      <path d="M10 24 q52 6 104 0" opacity=".4" />
      <line x1="62" y1="14" x2="62" y2="22" opacity=".3" />
      <circle cx="62" cy="11" r="3.1" fill="currentColor" stroke="none" />
    </svg>
  </div>

  <p class="statement reveal">人は、身体の状態の中で考えている</p>

  <div class="spacer-s"></div>

  <p class="lead reveal">呼吸が深いという人は少ない。<br />
  神経系が落ち着いているという言葉は届く。<br />
  安心しているという人はなかなかいない、試みれば。</p>

  <p class="statement reveal">状態が先にある</p>

  <div class="spacer-s"></div>

  <p class="lead reveal">そしてその状態は、伝染する。<br />
  誰かが落ち着くと、場全体も落ち着く。</p>

  <p class="statement reveal">だとすれば、組織文化にも<br />身体のレイヤーがあるのではないだろうか</p>

  <!-- 循環図：身体・意識・場・組織文化（Claude Design / body-od-visual.svg インライン） -->
  <div class="state-viz reveal">
    <svg width="100%" viewBox="0 0 680 455" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="身体・意識・場・組織文化が互いに絡み合う循環の図">
      <defs>
        <linearGradient id="rise" x1="0" y1="410" x2="0" y2="70" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#6a5d4d" stop-opacity="0.66"/>
          <stop offset="1" stop-color="#6a5d4d" stop-opacity="0.34"/>
        </linearGradient>
      </defs>

      <!-- 組織・文化レイヤー：横に流れる繊維 -->
      <path fill="none" stroke="#8a7762" stroke-linecap="round" stroke-width="1" stroke-opacity="0.42" d="M150,100 Q232,94 312,100 T468,100">
        <animateTransform attributeName="transform" type="translate" values="-6 0;6 0;-6 0" dur="15s" repeatCount="indefinite"/>
      </path>
      <path fill="none" stroke="#8a7762" stroke-linecap="round" stroke-width="1" stroke-opacity="0.32" d="M150,116 Q232,122 312,116 T468,116">
        <animateTransform attributeName="transform" type="translate" values="7 0;-7 0;7 0" dur="18s" repeatCount="indefinite"/>
      </path>
      <path fill="none" stroke="#8a7762" stroke-linecap="round" stroke-width="1" stroke-opacity="0.40" d="M152,132 Q234,126 314,132 T466,132">
        <animateTransform attributeName="transform" type="translate" values="-5 0;5 0;-5 0" dur="13s" repeatCount="indefinite"/>
      </path>
      <path fill="none" stroke="#8a7762" stroke-linecap="round" stroke-width="0.9" stroke-opacity="0.26" d="M158,150 Q238,156 318,150 T460,150">
        <animateTransform attributeName="transform" type="translate" values="6 0;-6 0;6 0" dur="21s" repeatCount="indefinite"/>
      </path>

      <!-- 身体間の循環ループ -->
      <path fill="none" stroke="url(#rise)" stroke-linecap="round" stroke-width="1.1" d="M200,410 C200,68 320,68 320,410 C320,250 200,250 200,410 Z">
        <animateTransform attributeName="transform" type="rotate" values="-1.2 260 410;1.2 260 410;-1.2 260 410" dur="9s" repeatCount="indefinite"/>
      </path>
      <path fill="none" stroke="url(#rise)" stroke-linecap="round" stroke-width="1.1" d="M320,410 C320,68 440,68 440,410 C440,250 320,250 320,410 Z">
        <animateTransform attributeName="transform" type="rotate" values="1.2 380 410;-1.2 380 410;1.2 380 410" dur="11s" repeatCount="indefinite"/>
      </path>
      <path fill="none" stroke="url(#rise)" stroke-linecap="round" stroke-width="1" d="M200,410 C200,52 440,52 440,410 C440,300 200,300 200,410 Z">
        <animateTransform attributeName="transform" type="rotate" values="0.8 320 410;-0.8 320 410;0.8 320 410" dur="14s" repeatCount="indefinite"/>
      </path>

      <!-- 場・空気レイヤー：横の流れ -->
      <path fill="none" stroke="#7e8c92" stroke-linecap="round" stroke-width="0.9" stroke-opacity="0.30" d="M130,192 Q240,186 350,192 T448,192">
        <animateTransform attributeName="transform" type="translate" values="-7 0;7 0;-7 0" dur="14s" repeatCount="indefinite"/>
      </path>
      <path fill="none" stroke="#7e8c92" stroke-linecap="round" stroke-width="0.9" stroke-opacity="0.24" d="M126,212 Q236,206 346,212 T450,212">
        <animateTransform attributeName="transform" type="translate" values="8 0;-8 0;8 0" dur="17s" repeatCount="indefinite"/>
      </path>
      <path fill="none" stroke="#7e8c92" stroke-linecap="round" stroke-width="0.8" stroke-opacity="0.18" d="M134,232 Q244,226 354,232 T446,232">
        <animateTransform attributeName="transform" type="translate" values="-6 0;6 0;-6 0" dur="20s" repeatCount="indefinite"/>
      </path>

      <!-- 意識のさざ波（各身体から） -->
      <ellipse fill="none" stroke="#7e8c92" stroke-width="0.8" cx="200" cy="300" rx="4" ry="1.5" opacity="0">
        <animate attributeName="rx" values="4;48" dur="5s" begin="0s" repeatCount="indefinite"/>
        <animate attributeName="ry" values="1.5;14" dur="5s" begin="0s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values="0.30;0" dur="5s" begin="0s" repeatCount="indefinite"/>
      </ellipse>
      <ellipse fill="none" stroke="#7e8c92" stroke-width="0.8" cx="200" cy="300" rx="4" ry="1.5" opacity="0">
        <animate attributeName="rx" values="4;48" dur="5s" begin="2.5s" repeatCount="indefinite"/>
        <animate attributeName="ry" values="1.5;14" dur="5s" begin="2.5s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values="0.30;0" dur="5s" begin="2.5s" repeatCount="indefinite"/>
      </ellipse>
      <ellipse fill="none" stroke="#7e8c92" stroke-width="0.8" cx="320" cy="300" rx="4" ry="1.5" opacity="0">
        <animate attributeName="rx" values="4;48" dur="5s" begin="0.9s" repeatCount="indefinite"/>
        <animate attributeName="ry" values="1.5;14" dur="5s" begin="0.9s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values="0.30;0" dur="5s" begin="0.9s" repeatCount="indefinite"/>
      </ellipse>
      <ellipse fill="none" stroke="#7e8c92" stroke-width="0.8" cx="320" cy="300" rx="4" ry="1.5" opacity="0">
        <animate attributeName="rx" values="4;48" dur="5s" begin="3.4s" repeatCount="indefinite"/>
        <animate attributeName="ry" values="1.5;14" dur="5s" begin="3.4s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values="0.30;0" dur="5s" begin="3.4s" repeatCount="indefinite"/>
      </ellipse>
      <ellipse fill="none" stroke="#7e8c92" stroke-width="0.8" cx="440" cy="300" rx="4" ry="1.5" opacity="0">
        <animate attributeName="rx" values="4;48" dur="5s" begin="1.7s" repeatCount="indefinite"/>
        <animate attributeName="ry" values="1.5;14" dur="5s" begin="1.7s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values="0.30;0" dur="5s" begin="1.7s" repeatCount="indefinite"/>
      </ellipse>
      <ellipse fill="none" stroke="#7e8c92" stroke-width="0.8" cx="440" cy="300" rx="4" ry="1.5" opacity="0">
        <animate attributeName="rx" values="4;48" dur="5s" begin="4.2s" repeatCount="indefinite"/>
        <animate attributeName="ry" values="1.5;14" dur="5s" begin="4.2s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values="0.30;0" dur="5s" begin="4.2s" repeatCount="indefinite"/>
      </ellipse>

      <!-- 身体の原点 -->
      <line stroke="#5b4f42" stroke-linecap="round" x1="178" y1="414" x2="222" y2="414" stroke-width="1" stroke-opacity="0.26"/>
      <line stroke="#5b4f42" stroke-linecap="round" x1="298" y1="414" x2="342" y2="414" stroke-width="1" stroke-opacity="0.26"/>
      <line stroke="#5b4f42" stroke-linecap="round" x1="418" y1="414" x2="462" y2="414" stroke-width="1" stroke-opacity="0.26"/>
      <circle fill="#5b4f42" cx="200" cy="410" r="2.6"/>
      <circle fill="#5b4f42" cx="320" cy="410" r="2.6"/>
      <circle fill="#5b4f42" cx="440" cy="410" r="2.6"/>

      <!-- ラベル -->
      <text fill="#9a8e7b" font-family="'Helvetica Neue',Arial,sans-serif" font-size="11" letter-spacing="1.5" x="505" y="108">CULTURE</text>
      <text fill="#4a4138" font-family="var(--gothic)" font-size="13" x="505" y="127">組織・文化</text>

      <text fill="#9a8e7b" font-family="'Helvetica Neue',Arial,sans-serif" font-size="11" letter-spacing="1.5" x="505" y="196">FIELD</text>
      <text fill="#4a4138" font-family="var(--gothic)" font-size="13" x="505" y="215">場・空気</text>

      <text fill="#9a8e7b" font-family="'Helvetica Neue',Arial,sans-serif" font-size="11" letter-spacing="1.5" x="505" y="292">CONSCIOUSNESS</text>
      <text fill="#4a4138" font-family="var(--gothic)" font-size="13" x="505" y="311">意識の状態</text>

      <text fill="#9a8e7b" font-family="'Helvetica Neue',Arial,sans-serif" font-size="11" letter-spacing="1.5" x="505" y="388">BODY</text>
      <text fill="#4a4138" font-family="var(--gothic)" font-size="13" x="505" y="407">身体の状態</text>
    </svg>
  </div>

  <p class="lead reveal">文化は、毎日の身体的なやりとりの積み重ねとして生きているのかもしれない。<br />
  挨拶の仕方、会議のテンポ、会議を延長させるときの沈黙。<br />
  慣習は、身体化されて初めて文化になるのではないか。</p>

  <div class="linkmark reveal" aria-hidden="true">
    <svg width="58" height="40" viewBox="0 0 58 40" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 28 L26 10 L44 18 L36 34 L18 36 Z" opacity=".4" />
      <path d="M26 10 L36 34" opacity=".3" />
      <circle cx="26" cy="10" r="2.4" fill="currentColor" stroke="none" />
      <circle cx="10" cy="28" r="1.8" fill="currentColor" stroke="none" opacity=".55" />
      <circle cx="44" cy="18" r="1.8" fill="currentColor" stroke="none" opacity=".55" />
      <circle cx="36" cy="34" r="1.8" fill="currentColor" stroke="none" opacity=".55" />
      <circle cx="18" cy="36" r="1.8" fill="currentColor" stroke="none" opacity=".55" />
    </svg>
  </div>
  <p class="reveal" style="font-family:var(--gothic);font-weight:300;font-size:14px;color:var(--ink-soft);">
    この問いを、世界の研究者たちも探っている。<br />
    <a class="link-clay" href="/research">探究の背景にある文献マップへ →</a>
  </p>
</section>
