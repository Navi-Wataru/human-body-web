<section class="relative mx-auto max-w-shell overflow-hidden px-gutter pt-hero pb-section">

  <!-- Background illustration -->
  <img
    src="/il/open.png"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 h-full w-full select-none object-contain object-center sm:object-right opacity-[0.15] sm:opacity-50"
  />

  <!-- Content -->
  <div class="relative max-w-measure">
    <div class="mb-10">
      <span class="block h-[9px] w-[9px] rounded-full bg-seal"></span>
    </div>

    <h1 class="font-serif text-anchor font-normal text-ink">ととのえたら、<br />ゆるんで、<br />ほどける。</h1>

    <p class="mt-12 font-sans text-micro font-light tracking-[0.16em] text-ink-faint">
      いま抱えている問いを、身体性から考えてみたい人へ
    </p>
  </div>

</section>
